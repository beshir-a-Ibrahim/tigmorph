# tigmorph gold standard — Raz (1973), Chapter 5: verb morphology
# Hand-curated from the full transcription. Forms are in Raz's Latin transcription (gemination,
# ə and vowel length visible); Ge'ez is derived mechanically by tigmorph.fidel.
#
# FORMAT
#   @ lemma | root=… | type=A|B|C|D | deriv=base|tə|ʼa|ʼat|ʼatta|ʼan|ʼas|ʼattan|ʼattas|ʼasta | sec=§ | gloss=…
#   <slot>: <sg cells> | <pl cells>        full paradigm row (sg: 1sg 2sm 2sf 3sm 3sf; pl: 1pl 2pm 2pf 3pm 3pf)
#   imp: 2sm 2sf 2pm 2pf                   imperative
#   <slot>.<person>[>obj]: form            single cell (obj = object person: 1sg 1pl 2sm 2sf 2pm 2pf 3sm 3sf 3pm 3pf)
#   slots: perf impf juss ij (= impf and juss identical) imp; prefix neg. = negated, colloq. = prefixless imperfect
#   cell: variants separated by ',' ; '-' = no form given ; '(ə)' = optional ə (both variants are gold)
#   trailing  [fix: …]  = transcription/print error corrected (original shown)
#   trailing  [rule]    = form stated by Raz's rule ("as 1st person singular" etc.), not printed as a form
#
# ---------------------------------------------------------------- § 5.3 strong triradicals
@ qanṣa | root=q-n-ṣ | type=A | deriv=base | sec=5.3.2 | gloss=to get up
perf: qanaṣko qanaṣka qanaṣki qanṣa qanṣat | qanaṣna qanaṣkum qanaṣkən qanṣaw qanṣaya
impf: ʼəqannəṣ təqannəṣ təqanṣi ləqannəṣ təqannəṣ | ʼənqannəṣ təqanṣo təqanṣa ləqanṣo ləqanṣa   [fix: 3sf təqannaṣ[?]]
juss: ʼəqnaṣ təqnaṣ təqnaṣi ləqnaṣ təqnaṣ | nəqnaṣ təqnaṣo təqnaṣa ləqnaṣo ləqnaṣa
imp: qənaṣ qənaṣi qənaṣo qənaṣa

@ mazzana | root=m-z-n | type=B | deriv=base | sec=5.3.2 | gloss=to weigh
perf: mazzanko mazzanka mazzanki mazzana mazzanat | mazzanna mazzankum mazzankən mazzanaw mazzanaya
ij: ʼəmazzən təmazzən təmazni ləmazzən təmazzən | ʼənmazzən təmazno təmazna ləmazno ləmazna
juss.1pl: nəmazzən
imp: mazzən mazni mazno mazna

@ kātaba | root=k-t-b | type=C | deriv=base | sec=5.3.2 | gloss=to vaccinate
perf: kātabko kātabka kātabki kātaba kātabat | kātabna kātabkum kātabkən kātabaw kātabaya
ij: ʼəkātəb təkātəb təkātbi ləkātəb təkātəb | ʼənkātəb təkātbo təkātba ləkātbo ləkātba
juss.1pl: nəkātəb   [fix: nakātəb[?]; jussive 1pl prefix is nə- (§ 5.3.1)]
imp: kātəb kātbi kātbo kātba

@ balālasa | root=b-l-s | type=D | deriv=base | sec=5.3.2 | gloss=to keep on answering
perf.3sm: balālasa
ij.3sm: ləbalāləs
imp.2sm: balāləs

@ sarqa | root=s-r-q | type=A | deriv=base | sec=5.3.3 | gloss=to steal
neg.perf.3sm: ʼisarqa

@ faqda | root=f-q-d | type=A | deriv=base | sec=5.3.3 | gloss=to remember
neg.impf.1sg: ʼiʼəfaqqəd

@ qatla | root=q-t-l | type=A | deriv=base | sec=5.3.3 | gloss=to kill
# negative imperative = negated jussive 2nd persons
neg.juss.2sm: ʼitəqtal
neg.juss.2sf: ʼitəqtali
neg.juss.2pm: ʼitəqtalo
neg.juss.2pf: ʼitəqtala

@ fagra | root=f-g-r | type=A | deriv=base | sec=5.3.4 | gloss=to go out
# colloquial imperfect: prefixes of 2nd/3rd persons omitted
colloq.impf: ʼəfaggər faggər fagri faggər faggər | ʼənfaggər fagro fagra fagro fagra

